# This repo's `overrides` field (package.json: `conventional-changelog-writer:
# ^9.2.0`) forces a newer conventional-changelog-writer into the tree, which
# depends on conventional-commits-filter@6.0.1. commitlint's own dependency
# chain (@commitlint/cli -> @commitlint/read -> @conventional-changelog/git-
# client) also wants conventional-commits-filter, but resolves to the older
# ^5.0.0 range some semantic-release plugins ask for directly (`npm ls
# conventional-commits-filter` shows the resulting dedup as "invalid").
# Without this setting, npm's default resolver and the npm version bundled in
# node:22-alpine (used by CI's lockfile-integrity job and the release Docker
# build) disagree with whatever npm generated the lockfile about how to
# settle that conflict, and `npm ci` fails with "lock file ... does not
# satisfy" even though `npm install` succeeded moments earlier. This is
# unrelated to this repo's TypeScript version -- it is purely a
# commitlint/semantic-release transitive dependency conflict, reproducible
# without eslint or typescript-eslint in the tree at all. It is also not new:
# it is the same failure signature the lockfile-integrity CI job's own
# comment documents from v1.8.0-1.8.2 ("npm ci EUSAGE on
# conventional-commits-filter", producing no release image).
legacy-peer-deps=true
