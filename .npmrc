# typescript-eslint (and its cosmiconfig-typescript-loader/ts-api-utils dependency
# chain, pulled in transitively by @commitlint/load and semantic-release) declares a
# peer range of `typescript@>=4.8.4 <6.1.0`. This repo intentionally runs the
# TypeScript 7 preview compiler (see package.json), which is newer than any published
# typescript-eslint peer range supports as of this writing -- none of our lint rules
# are type-aware (no `parserOptions.project`), so the mismatch has no practical effect
# on what ESLint actually checks. Without this, `npm ci` (used by CI's
# lockfile-integrity job and the build job) fails with ERESOLVE.
legacy-peer-deps=true
